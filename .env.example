# Globus-Pulse — máquina interna de marketing
# Copiar a .env y completar. Nunca commitear secretos.

DATABASE_URL=sqlite:///./data/pulse.db
# DATABASE_URL=postgresql+psycopg2://pulse:pulse@localhost:5432/pulse

ASSETS_DIR=./data/assets
OUTBOUND_DIR=./outbound
BRAND_FILE=./config/brand.yaml
CALENDAR_FILE=./config/calendar.yaml
TIMEZONE=America/Mexico_City

# Auto-aprobar piezas internas (esta no es una plataforma de clientes)
AUTO_APPROVE=true

# Plataformas activas (coma). Solo se intenta publicar las que sí se van a usar.
ENABLED_PLATFORMS=webhook,web

# Publicación inmediata de jobs vencidos en cada ciclo
PUBLISH_DUE=true

# Piezas nuevas a generar por ciclo
GENERATE_PER_CYCLE=1

# --- Webhook (publicación real HTTP) ---
WEBHOOK_URL=
WEBHOOK_TOKEN=

# --- X (Twitter) OAuth 1.0a user context ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202608

# --- Meta (Instagram + Facebook Page) ---
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=

# --- Sitio Globus (NO toca Globus-Core-Web) ---
WEB_PUBLISH_ENDPOINT=
WEB_PUBLISH_TOKEN=
